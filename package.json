{
  "name": "smartbell-local",
  "version": "1.0.0",
  "description": "Sistem Bel Otomatis Sekolah Berbasis Web Lokal (SmartBell Local)",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:all": "node scripts/start-all.js --dev",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "start:all": "node scripts/start-all.js",
    "scheduler": "tsx src/scheduler/worker.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.6.1",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.453.0",
    "next": "^14.2.23",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "tailwind-merge": "^2.5.4",
    "unzipper": "^0.12.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/unzipper": "^0.10.10",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
