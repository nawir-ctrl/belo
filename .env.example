# Konfigurasi Lingkungan SmartBell Local
# File ini memuat pengaturan default untuk deployment lokal satu komputer.

# Port dan Host lokal (Hanya bind ke 127.0.0.1 secara default demi keamanan)
PORT=3000
HOST=127.0.0.1
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Lokasi Database SQLite persisten
# Format Prisma: file:../data/smartbell.db (relatif terhadap direktori prisma/)
DATABASE_URL="file:../data/smartbell.db"

# Kunci rahasia JWT lokal untuk session cookie (minimal 32 karakter)
JWT_SECRET=smartbell_secret_key_lokal_sekolah_aman_dan_rahasia_32_karakter

# Zona Waktu default (Asia/Makassar untuk WITA, atau Asia/Jakarta untuk WIB, Asia/Jayapura untuk WIT)
DEFAULT_TIMEZONE=Asia/Makassar

# Direktori Penyimpanan File
AUDIO_DIR=data/audio
BACKUP_DIR=data/backups

# Scheduler Configuration
SCHEDULER_CHECK_INTERVAL_SEC=10
SCHEDULER_MAX_CATCHUP_MINUTES=5
